# Copiez ce fichier vers .env pour lancer le serveur sans l'application Windows.
TRANSLATION_PROVIDER=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=hf.co/tencent/Hy-MT2-7B-GGUF:Q4_K_M
OLLAMA_MODEL_TYPE=hy-mt
OLLAMA_CONCURRENCY=2

PORT=47831
DATABASE_PATH=./data/subtitles.db
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=45000
PROVIDER_MAX_RETRIES=1
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Inutile avec Ollama. Ne renseignez une clé que pour développer un fournisseur distant.
OPENCODE_GO_API_KEY=
