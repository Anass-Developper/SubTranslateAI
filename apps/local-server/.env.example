# Copiez ce fichier vers .env et remplacez la valeur ci-dessous.
OPENCODE_GO_API_KEY=ma_cle

# opencode | ollama | hybrid (Ollama d'abord, OpenCode Go en secours)
TRANSLATION_PROVIDER=hybrid
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=hf.co/tencent/Hy-MT2-7B-GGUF:Q4_K_M
# hy-mt | translategemma | chat-json
OLLAMA_MODEL_TYPE=hy-mt
OLLAMA_CONCURRENCY=2

# Réglages optionnels
PORT=47831
DATABASE_PATH=./data/subtitles.db
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=1
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
