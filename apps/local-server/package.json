{
  "name": "@dual-subtitles/local-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build --workspace @dual-subtitles/shared && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "benchmark:translations": "tsx scripts/benchmark-translations.ts",
    "test": "npm run build --workspace @dual-subtitles/shared && vitest run",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "@dual-subtitles/shared": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.11.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
