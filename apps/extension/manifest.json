{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "version": "0.5.3",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SubTranslateAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-dual-subtitles": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_toggleCommandDescription__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.netflix.com/*",
        "https://netflix.com/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.fr/gp/video/*",
        "https://www.canalplus.com/*",
        "https://tv.apple.com/*",
        "https://*.bilibili.com/*",
        "https://bilibili.com/*",
        "https://*.bilibili.tv/*",
        "https://bilibili.tv/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.netflix.com/*",
        "https://netflix.com/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.fr/gp/video/*",
        "https://www.canalplus.com/*",
        "https://tv.apple.com/*",
        "https://*.bilibili.com/*",
        "https://bilibili.com/*",
        "https://*.bilibili.tv/*",
        "https://bilibili.tv/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
