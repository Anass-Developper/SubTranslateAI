# Copiez ce fichier vers apps/local-server/.env puis remplacez la valeur ci-dessous.
# Ne partagez et ne versionnez jamais votre clé réelle.
OPENCODE_GO_API_KEY=remplacez_par_votre_cle_opencode_go

# opencode | ollama | hybrid (Ollama d'abord, OpenCode Go en secours)
TRANSLATION_PROVIDER=hybrid
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=hf.co/tencent/Hy-MT2-7B-GGUF:Q4_K_M
# hy-mt | translategemma | chat-json
OLLAMA_MODEL_TYPE=hy-mt
OLLAMA_CONCURRENCY=2

# Le serveur refuse volontairement toute autre interface que 127.0.0.1.
PORT=47831

# Chemin relatif au dossier apps/local-server, ou chemin absolu.
DATABASE_PATH=./data/subtitles.db

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Délai maximal d'un appel au fournisseur et nouvelle tentative après réponse invalide/erreur transitoire.
REQUEST_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=1

# Limitation par fenêtre pour protéger le serveur local des boucles accidentelles.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
